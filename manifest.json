{
  "manifest_version": 2,
  "name": "NexyBlock",
  "version": "0.1.11",
  "description": "Experimental YouTube ad filtering for Firefox: blocks known ad requests, trims ad data from player responses, hides ad slots and clicks Skip. Local only, no telemetry.",
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "https://youtube.com/*",
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*",
    "https://*.doubleclick.net/*",
    "https://*.googlesyndication.com/*",
    "https://*.googleadservices.com/*"
  ],
  "background": {
    "scripts": [
      "core.js",
      "stream.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_title": "NexyBlock",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_security_policy": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
  "browser_specific_settings": {
    "gecko": {
      "id": "nexyblock-youtube@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
